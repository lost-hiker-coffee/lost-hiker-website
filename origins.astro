---
import Layout from '../layouts/Layout.astro';
import origins from '../data/origins.json';
---

<Layout title="Origins" description="Where Lost Hiker Coffee beans come from — the farms, regions, and importers behind every roast.">

  <section class="page-hero">
    <div class="container">
      <p class="section-label">Sourcing</p>
      <h1 class="page-title">Where it comes from.</h1>
      <p class="page-intro">We buy green beans from importers we trust — people who work directly with farms and care about how coffee is grown and who grows it. Here's where our beans come from right now.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {origins.map((origin, index) => (
        <article class={`origin-card ${index < origins.length - 1 ? 'with-divider' : ''}`}>
          <div class="origin-image">
            <img src={origin.image} alt={`${origin.farm} — ${origin.region}, ${origin.country}`} loading="lazy" />
          </div>
          <div class="origin-content">
            <div class="origin-header">
              <p class="origin-country">{origin.country} · {origin.region}</p>
              <h2 class="origin-name">{origin.farm}</h2>
            </div>

            <p class="origin-description">{origin.description}</p>
            <p class="origin-farm-story">{origin.farmStory}</p>

            <div class="origin-details">
              <div class="detail">
                <span class="detail-label">Altitude</span>
                <span class="detail-value">{origin.altitude}</span>
              </div>
              <div class="detail">
                <span class="detail-label">Process</span>
                <span class="detail-value">{origin.process}</span>
              </div>
              <div class="detail">
                <span class="detail-label">Variety</span>
                <span class="detail-value">{origin.variety}</span>
              </div>
              <div class="detail">
                <span class="detail-label">Used in</span>
                <span class="detail-value">{origin.roastsUsedIn.join(', ')}</span>
              </div>
            </div>

            <div class="origin-procured">
              <span class="detail-label">Procured via</span>
              <a href={origin.procuredViaUrl} target="_blank" rel="noopener noreferrer" class="procured-link">
                {origin.procuredVia} ↗
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="sourcing-note">
    <div class="container">
      <div class="note-inner">
        <p class="section-label">Our Approach</p>
        <h2>Buying well.</h2>
        <p>We source through importers who visit farms, maintain direct relationships with growers, and pay fairly. We're a small operation, which means we buy in small quantities — but that also means we can be selective and intentional about what we bring in.</p>
        <p>Our sourcing changes as our relationships and options evolve. When we add a new origin or change a supplier, we'll update this page.</p>
      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 5rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1.25rem;
  }

  .page-intro {
    font-size: 1.1rem;
    color: var(--mid);
    max-width: 680px;
    font-style: italic;
    line-height: 1.75;
  }

  .origin-card {
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 4rem;
    align-items: start;
    margin-bottom: 5rem;
    padding-bottom: 5rem;
  }

  .origin-card.with-divider {
    border-bottom: 1px solid var(--border);
  }

  .origin-image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid var(--border);
    position: sticky;
    top: 90px;
  }

  .origin-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .origin-country {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green);
  }

  .origin-name {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.15;
    margin-top: 0.25rem;
  }

  .origin-description,
  .origin-farm-story {
    color: var(--mid);
    font-size: 1rem;
    line-height: 1.8;
  }

  .origin-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 2rem;
    padding: 1.5rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 2px;
    margin-top: 0.5rem;
  }

  .detail {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .detail-label {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .detail-value {
    font-size: 0.95rem;
    color: var(--cream);
  }

  .origin-procured {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .procured-link {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green);
    text-decoration: none;
    transition: color 0.2s;
  }

  .procured-link:hover {
    color: var(--green-hover);
  }

  /* Sourcing note */
  .sourcing-note {
    background-color: var(--surface);
    border-top: 1px solid var(--border);
    padding: 4rem 0;
  }

  .note-inner {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .note-inner h2 {
    font-size: 2rem;
  }

  .note-inner p {
    color: var(--mid);
    font-size: 1rem;
    line-height: 1.8;
  }

  @media (max-width: 900px) {
    .origin-card {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .origin-image img {
      position: static;
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 600px) {
    .origin-details {
      grid-template-columns: 1fr;
    }
  }
</style>
