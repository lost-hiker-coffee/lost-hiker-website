---
import Layout from '../layouts/Layout.astro';
import CoffeeCard from '../components/CoffeeCard.astro';
import roasts from '../data/roasts.json';

const featuredRoasts = roasts.slice(0, 3);
---

<Layout title="Home" description="Small-batch coffee roasted in Sayward, BC. Lost Hiker Coffee Roasters.">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-image-wrap">
      <img src="/images/bagskusam.jpg" alt="Lost Hiker Coffee bags with mountain backdrop" />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content container">
      <div class="hero-logo">
        <img src="/images/logo.jpg" alt="Lost Hiker Coffee Roasters" />
      </div>
      <p class="hero-label">Lost Hiker Coffee Roasters · Sayward, BC</p>
      <h1 class="hero-heading">Roasted in Sayward<br />for the wandering mind<br />and wandering kind.</h1>
      <p class="hero-sub">Small-batch coffee, hand-roasted in the heart of Vancouver Island's north.</p>
      <div class="hero-actions">
        <a href="/our-coffees" class="btn btn-primary">Explore Our Coffee</a>
        <a href="/about" class="btn btn-outline">Our Story</a>
      </div>
    </div>
  </section>

  <!-- Intro strip -->
  <section class="intro-strip">
    <div class="container">
      <p class="intro-text">We roast in small batches because that's the only way to do it right. Every bag leaves Sayward with intention — sourced from farms we trust, roasted to order, and made to be shared on trails, at tables, and anywhere worth being.</p>
    </div>
  </section>

  <!-- Featured coffees -->
  <section class="section featured-section">
    <div class="container">
      <p class="section-label">The Lineup</p>
      <div class="featured-header">
        <h2 class="section-title">Our Coffees</h2>
        <a href="/our-coffees" class="view-all">View all roasts →</a>
      </div>
      <div class="coffee-grid">
        {featuredRoasts.map(roast => (
          <CoffeeCard
            name={roast.name}
            roast={roast.roast}
            roastLevel={roast.roastLevel}
            origin={roast.origin}
            description={roast.description}
            image={roast.image}
            available={roast.available}
          />
        ))}
      </div>
      <div class="featured-cta">
        <a href="/our-coffees" class="btn btn-outline">See All Five Roasts</a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- About teaser -->
  <section class="section about-teaser">
    <div class="container about-teaser-inner">
      <div class="about-teaser-image">
        <img src="/images/leahjordan.jpg" alt="Leah and Jordan, founders of Lost Hiker Coffee Roasters" />
      </div>
      <div class="about-teaser-text">
        <p class="section-label">Who We Are</p>
        <h2 class="section-title">Started on a trail.<br />Built at home.</h2>
        <p>Jordan and Leah have been roasting coffee together since long before they ever thought of making it a business. It started as a hobby — a shared love of good coffee and the mountains surrounding their home in Sayward. Eventually, the hobby turned into something more.</p>
        <p>Lost Hiker is named for the feeling of being wonderfully, willfully off-course — the kind of hike where you're not quite sure where you're going, but you're certain it's worth finding out.</p>
        <a href="/about" class="btn btn-outline" style="margin-top: 1.5rem;">Read Our Story</a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Origins teaser -->
  <section class="section origins-teaser">
    <div class="container">
      <div class="origins-teaser-inner">
        <div class="origins-text">
          <p class="section-label">Where It Comes From</p>
          <h2 class="section-title">Sourced with care.</h2>
          <p>Our beans come from farms we know and importers we trust. Right now, most of our coffee comes from the highlands of Colombia's Huila region — a place known for exceptional growing conditions and carefully tended crops. We like to know the story behind the bag.</p>
          <a href="/origins" class="btn btn-outline" style="margin-top: 1.5rem;">Learn About Our Sources</a>
        </div>
        <div class="origins-image">
          <img src="/images/colombiahuila.jpg" alt="Coffee farm in Colombia Huila" />
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Signs / brand image -->
  <section class="section signs-section">
    <div class="container signs-inner">
      <div class="signs-image">
        <img src="/images/ourcoffees.jpg" alt="Lost Hiker Coffee — the full lineup" />
      </div>
      <div class="signs-text">
        <p class="section-label">Order Now</p>
        <h2 class="section-title">Ready to find your roast?</h2>
        <p>From a clean morning light to a deep, earthy dark — there's a Lost Hiker roast for wherever you're headed. Order online and we'll ship it to you fresh from Sayward.</p>
        <a href="/our-coffees" class="btn btn-primary" style="margin-top: 1.5rem;">Shop Our Coffee</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
  }

  .hero-image-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(26, 25, 24, 0.55) 0%,
      rgba(26, 25, 24, 0.75) 60%,
      rgba(26, 25, 24, 0.95) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-top: 6rem;
    padding-bottom: 6rem;
    max-width: 700px;
  }

  .hero-logo img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 1.5rem;
    border: 2px solid rgba(240, 234, 216, 0.15);
  }

  .hero-label {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 1rem;
  }

  .hero-heading {
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .hero-sub {
    font-size: 1.1rem;
    color: var(--mid);
    max-width: 480px;
    margin-bottom: 2.5rem;
    font-style: italic;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Intro strip */
  .intro-strip {
    background-color: var(--surface);
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .intro-text {
    font-size: 1.15rem;
    font-style: italic;
    color: var(--mid);
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    line-height: 1.8;
  }

  /* Featured coffees */
  .featured-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .featured-header .section-title {
    margin-bottom: 0;
  }

  .view-all {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green);
    text-decoration: none;
    transition: color 0.2s;
  }

  .view-all:hover {
    color: var(--green-hover);
  }

  .coffee-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .featured-cta {
    text-align: center;
    margin-top: 3rem;
  }

  /* About teaser */
  .about-teaser-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-teaser-image img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid var(--border);
  }

  .about-teaser-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-teaser-text p {
    color: var(--mid);
    font-size: 1rem;
  }

  /* Origins teaser */
  .origins-teaser-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .origins-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .origins-text p {
    color: var(--mid);
    font-size: 1rem;
  }

  .origins-image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid var(--border);
  }

  /* Signs section */
  .signs-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .signs-image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid var(--border);
  }

  .signs-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .signs-text p {
    color: var(--mid);
    font-size: 1rem;
  }

  @media (max-width: 900px) {
    .coffee-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 80vh;
    }

    .coffee-grid {
      grid-template-columns: 1fr;
    }

    .about-teaser-inner,
    .origins-teaser-inner,
    .signs-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .origins-image {
      order: -1;
    }
  }
</style>
