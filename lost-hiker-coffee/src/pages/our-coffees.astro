---
import Layout from '../layouts/Layout.astro';
import CoffeeCard from '../components/CoffeeCard.astro';
import roasts from '../data/roasts.json';
---

<Layout title="Our Coffee" description="Explore the Lost Hiker Coffee lineup — five small-batch roasts from light to extra dark.">

  <section class="page-hero">
    <div class="container">
      <p class="section-label">The Lineup</p>
      <h1 class="page-title">Our Coffee</h1>
      <p class="page-intro">Five roasts, each named for a place or feeling that means something to us. From the clean brightness of a mountain morning to the deep, grounding weight of old-growth forest — there's a Lost Hiker cup for wherever you are.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="roast-legend">
        <span class="legend-label">Roast level:</span>
        <div class="legend-dots">
          <span class="dot filled"></span><span class="dot empty"></span><span class="dot empty"></span><span class="dot empty"></span><span class="dot empty"></span>
          <span class="legend-word">Light</span>
        </div>
        <div class="legend-dots">
          <span class="dot filled"></span><span class="dot filled"></span><span class="dot filled"></span><span class="dot empty"></span><span class="dot empty"></span>
          <span class="legend-word">Medium</span>
        </div>
        <div class="legend-dots">
          <span class="dot filled"></span><span class="dot filled"></span><span class="dot filled"></span><span class="dot filled"></span><span class="dot filled"></span>
          <span class="legend-word">Dark</span>
        </div>
      </div>

      <div class="coffee-grid">
        {roasts.map(roast => (
          <CoffeeCard
            name={roast.name}
            roast={roast.roast}
            roastLevel={roast.roastLevel}
            origin={roast.origin}
            description={roast.description}
            image={roast.image}
            available={roast.available}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="order-note">
    <div class="container">
      <div class="order-note-inner">
        <div>
          <p class="section-label">How to Order</p>
          <h2>Ready to order?</h2>
          <p>Lost Hiker Coffee is roasted fresh in Sayward, BC and available locally (for now). Reach out through our contact page or find us on social media to place your order.</p>
        </div>
        <div class="order-actions">
          <a href="/contact" class="btn btn-primary">Get in Touch</a>
          <a href="https://www.facebook.com/losthikercoffeeroasters/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Find Us on Facebook</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 5rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1.25rem;
  }

  .page-intro {
    font-size: 1.1rem;
    color: var(--mid);
    max-width: 680px;
    font-style: italic;
    line-height: 1.75;
  }

  .roast-legend {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    padding: 1rem 1.25rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 2px;
  }

  .legend-label {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .legend-dots {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .legend-word {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mid);
    margin-left: 6px;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot.filled {
    background-color: var(--green);
  }

  .dot.empty {
    background-color: transparent;
    border: 1px solid rgba(90, 158, 110, 0.35);
  }

  .coffee-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .order-note {
    background-color: var(--surface);
    border-top: 1px solid var(--border);
    padding: 4rem 0;
    margin-top: 2rem;
  }

  .order-note-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .order-note h2 {
    font-size: 2rem;
    margin: 0.5rem 0 1rem;
  }

  .order-note p {
    color: var(--mid);
    max-width: 540px;
    font-size: 1rem;
  }

  .order-actions {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .coffee-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .coffee-grid {
      grid-template-columns: 1fr;
    }

    .order-note-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
