---
interface Props {
  name: string;
  roast: string;
  roastLevel: number;
  origin: string;
  description: string;
  image: string;
  available: boolean;
}

const { name, roast, roastLevel, origin, description, image, available } = Astro.props;

// Build dots: filled up to roastLevel, empty after (max 5)
const dots = Array.from({ length: 5 }, (_, i) => i < roastLevel);
---

<article class="coffee-card">
  <div class="card-image">
    <img src={image} alt={`${name} — ${roast}`} loading="lazy" />
  </div>
  <div class="card-body">
    <div class="card-meta">
      <span class="card-origin">{origin}</span>
      <div class="roast-dots" aria-label={`Roast level: ${roastLevel} out of 5`}>
        {dots.map(filled => (
          <span class={`dot ${filled ? 'filled' : 'empty'}`}></span>
        ))}
      </div>
    </div>
    <h3 class="card-name">{name}</h3>
    <p class="card-roast">{roast}</p>
    <p class="card-description">{description}</p>
    {!available && <p class="card-unavailable">Currently unavailable</p>}
  </div>
</article>

<style>
  .coffee-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 3px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .coffee-card:hover {
    border-color: var(--border-green);
    transform: translateY(-3px);
  }

  .card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--surface-2);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .coffee-card:hover .card-image img {
    transform: scale(1.04);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }

  .card-origin {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green);
  }

  .roast-dots {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot.filled {
    background-color: var(--green);
  }

  .dot.empty {
    background-color: transparent;
    border: 1px solid rgba(90, 158, 110, 0.35);
  }

  .card-name {
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--cream);
    margin-top: 0.1rem;
  }

  .card-roast {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mid);
    margin-bottom: 0.5rem;
  }

  .card-description {
    font-size: 0.95rem;
    color: var(--mid);
    line-height: 1.65;
    flex: 1;
  }

  .card-unavailable {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
    margin-top: 0.5rem;
  }
</style>
