---
const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href="/" class="footer-logo-link">
          <img src="/images/logo.jpg" alt="Lost Hiker Coffee Roasters" width="56" height="56" />
        </a>
        <p class="footer-tagline">Roasted in Sayward for the<br />wandering mind and wandering kind.</p>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <ul role="list">
          <li><a href="/">Home</a></li>
          <li><a href="/our-coffees">Our Coffee</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/origins">Origins</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>

      <div class="footer-social">
        <p class="footer-location">Sayward, BC · Canada</p>
        <div class="social-links">
          <a href="https://www.facebook.com/losthikercoffeeroasters/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
            Facebook
          </a>
          <a href="https://www.instagram.com/losthikercoffee/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
            </svg>
            Instagram
          </a>
        </div>
        <a href="mailto:info@losthikercoffee.ca" class="footer-email">info@losthikercoffee.ca</a>
      </div>
    </div>

    <div class="footer-bottom">
      <hr class="divider" />
      <p class="footer-copy">© {year} Lost Hiker Coffee Roasters. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: var(--surface);
    border-top: 1px solid var(--border);
    padding: 4rem 0 2rem;
    margin-top: 4rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo-link img {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    opacity: 0.9;
    transition: opacity 0.2s;
  }

  .footer-logo-link:hover img {
    opacity: 1;
  }

  .footer-tagline {
    font-style: italic;
    color: var(--mid);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-nav a {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mid);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: var(--cream);
  }

  .footer-social {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .footer-location {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--mid);
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s;
  }

  .social-links a:hover {
    color: var(--green);
  }

  .footer-email {
    font-size: 0.9rem;
    color: var(--mid);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-email:hover {
    color: var(--green);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-copy {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--dim);
    text-transform: uppercase;
    text-align: center;
  }

  @media (max-width: 768px) {
    footer {
      padding: 3rem 0 2rem;
    }

    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
