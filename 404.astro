---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="This page doesn't exist — but the trail ahead might.">
  <section class="not-found">
    <div class="container">
      <p class="error-code">404</p>
      <h1>Trail lost.</h1>
      <p>This page doesn't exist — but that's okay. Sometimes the wrong fork leads somewhere worth finding.</p>
      <a href="/" class="btn btn-primary" style="margin-top: 2rem;">Back to Home</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: 70vh;
    display: flex;
    align-items: center;
    text-align: center;
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 540px;
    margin: 0 auto;
  }

  .error-code {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 7rem;
    font-weight: 700;
    color: var(--green);
    line-height: 1;
    opacity: 0.4;
  }

  h1 {
    font-size: 2.5rem;
  }

  p {
    color: var(--mid);
    font-size: 1.05rem;
    font-style: italic;
  }
</style>
